# Browser-safe Supabase project configuration (publishable anon key only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Do not add a service-role key here. The seed CLI accepts it only from your local shell:
# SUPABASE_URL=https://your-project.supabase.co SUPABASE_SERVICE_ROLE_KEY=... npm run seed:supabase
